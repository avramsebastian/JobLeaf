# Application Database (PostgreSQL)
POSTGRES_DB=db_name
POSTGRES_USER=db_user
POSTGRES_PASSWORD=db_password
POSTGRES_PORT=5432

# SonarQube Database & Server
SONARQUBE_DB=sonarqube_db
SONARQUBE_USER=sonarqube_user
SONARQUBE_PASSWORD=sonarqube_password
SONARQUBE_PORT=9000

# JWT signing secret: at least 32 random characters. Generate one, never reuse the example.
JWT_SECRET_KEY=change-me-to-a-random-secret-of-at-least-32-chars
