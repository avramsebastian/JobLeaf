                "login",
                "public"
              ]
            },
            "description": "Logs in with email and password and saves the returned JWT as {{jwtFromLogin}}. Use 'Bearer {{jwtFromLogin}}' to test with a real login instead of the generated token. Set loginPassword in the environment to the password your BCrypt hash was created from.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"{{loginPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Returns a JWT and the user', () => {",
                  "    pm.expect(body.jwtToken).to.be.a('string');",
                  "    pm.expect(body.user.email).to.eql('admin@example.com');",
                  "    pm.expect(body.user.role).to.eql('ROLE_ADMIN');",
                  "});",
                  "pm.environment.set('jwtFromLogin', body.jwtToken);"
                ]
              }
            }
          ]
        },
