      "value": "http://localhost:8080/jobleaf"
    },
    {
      "key": "serverUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "apiAccept",
      "value": "application/vnd.jobleaf+json;v=1.0"
    },
    {
      "key": "tokenUserId",
      "value": "6f1c2b7e-3d4a-4e5f-9a8b-1c2d3e4f5a02"
    },
    {
      "key": "tokenEmail",
      "value": "admin@example.com"
    },
    {
      "key": "tokenRoles",
      "value": "ROLE_ADMIN"
    }
  ],
  "item": [
    {
      "name": "1. Public endpoints",
      "description": "No token needed (paths ending in /public).",
      "item": [
        {
          "name": "List companies",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "{{apiAccept}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/companies/public",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "companies",
                "public"
              ]
            },
            "description": "Returns all companies with their jobs. Also shows the security headers in the Headers tab."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns companies with jobs', () => {",
                  "    const companies = pm.response.json();",
                  "    pm.expect(companies).to.be.an('array').that.is.not.empty;",
                  "    pm.expect(companies[0]).to.have.property('jobs');",
                  "});",
                  "pm.test('Security headers are present', () => {",
                  "    ['Content-Security-Policy', 'Referrer-Policy', 'Permissions-Policy', 'X-Content-Type-Options', 'X-Frame-Options']",
                  "        .forEach(header => pm.expect(pm.response.headers.has(header), header).to.be.true);",
                  "});"
                ]
              }
            }
          ]
        },
