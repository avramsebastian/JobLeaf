            },
            "description": "Creates a new user (unique email, mobile number and random password each run) and logs them in: the JWT comes back in the HttpOnly cookie and is copied into {{jwtFromRegister}}. Writes a row to the users table."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Logs the new user in as a job seeker', () => pm.expect(body.user.role).to.eql('ROLE_JOB_SEEKER'));",
                  "// The JWT is not in the body any more: it comes in an HttpOnly cookie",
                  "const tokenCookie = pm.response.headers.all().filter(h => h.key.toLowerCase() === 'set-cookie').map(h => h.value)",
                  "    .find(v => v.startsWith('JOBLEAF_ACCESS_TOKEN='));",
                  "pm.test('No token in the response body (JavaScript never sees it)', () => pm.expect(body).to.not.have.property('jwtToken'));",
                  "pm.test('Token cookie is HttpOnly, Secure, SameSite=Lax and only for the API (Path=/jobleaf)', () => {",
                  "    pm.expect(tokenCookie, 'Set-Cookie for JOBLEAF_ACCESS_TOKEN').to.exist;",
                  "    const flags = tokenCookie.toLowerCase();",
                  "    ['httponly', 'secure', 'samesite=lax', 'path=/jobleaf', 'max-age='].forEach(flag => pm.expect(flags).to.include(flag));",
                  "});",
                  "// Saved so the next requests can send it as a Bearer header (Postman may not send Secure cookies over http)",
                  "pm.environment.set('jwtFromRegister', tokenCookie.split(';')[0].substring('JOBLEAF_ACCESS_TOKEN='.length));",
                  "pm.environment.set('registeredEmail', body.user.email);"
                ]
              }
            }
          ]
        },
