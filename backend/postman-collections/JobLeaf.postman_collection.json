      "name": "1. Public endpoints",
      "description": "No token needed (paths ending in /public).",
      "item": [
        {
          "name": "Get CSRF token",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "{{apiAccept}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/csrf-token/public",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "csrf-token",
                "public"
              ]
            },
            "description": "Returns the CSRF token and sets the XSRF-TOKEN cookie. The collection script calls this automatically before every POST."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const token = pm.response.json().token;",
                  "const setCookie = pm.response.headers.all().filter(h => h.key.toLowerCase() === 'set-cookie').map(h => h.value)",
                  "    .find(v => v.startsWith('XSRF-TOKEN='));",
                  "pm.test('Returns the token and the header to send it in', () => {",
                  "    pm.expect(token).to.be.a('string').and.not.empty;",
                  "    pm.expect(pm.response.json().headerName).to.eql('X-XSRF-TOKEN');",
                  "});",
                  "pm.test('Sets the XSRF-TOKEN cookie with the same value as the token', () => {",
                  "    pm.expect(setCookie, 'Set-Cookie for XSRF-TOKEN').to.exist;",
                  "    pm.expect(setCookie).to.include('XSRF-TOKEN=' + token);",
                  "});",
                  "pm.test('Cookie is readable by JavaScript (no HttpOnly), so the frontend can copy it into the header', () => {",
                  "    pm.expect(setCookie.toLowerCase()).to.not.include('httponly');",
                  "});",
                  "pm.test('Cookie is valid for the whole site (Path=/)', () => pm.expect(setCookie).to.include('Path=/'));",
                  "pm.test('Cookie was stored in the Postman cookie jar', () => pm.expect(pm.cookies.get('XSRF-TOKEN')).to.eql(token));",
                  "pm.test('No session cookie: the API is stateless', () => {",
                  "    pm.expect(pm.response.headers.all().some(h => h.key.toLowerCase() === 'set-cookie' && h.value.startsWith('JSESSIONID'))).to.be.false;",
                  "});"
                ]
              }
            }
          ]
        },
