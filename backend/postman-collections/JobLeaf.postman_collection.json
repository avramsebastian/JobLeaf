                  "});",
                  "pm.test('Detail explains the problem', () => pm.expect(pm.response.json().detail).to.eql(\"The access token has expired, please log in again\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Secured path - tampered token (401)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "{{apiAccept}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwtTampered}}"
