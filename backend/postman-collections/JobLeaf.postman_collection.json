    {
      "name": "4. CSRF cookies",
      "description": "How the double-submit cookie protection reacts to the cookie and the header. These requests set the cookie and header themselves (X-Test-No-Csrf turns off the automatic token).",
      "item": [
        {
          "name": "CSRF - cookie only, no header (403)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "{{apiAccept}}"
              },
              {
                "key": "Content-Type",
                "value": "{{apiAccept}}"
              },
              {
                "key": "X-Test-No-Csrf",
                "value": "true"
              },
              {
                "key": "Cookie",
                "value": "XSRF-TOKEN=postman-cookie-only"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/contacts/public",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "contacts",
                "public"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Test\",\n  \"email\": \"postman@example.com\",\n  \"userType\": \"Employer\",\n  \"subject\": \"Testing\",\n  \"message\": \"Testing the CSRF cookie protection from Postman.\"\n}"
            },
            "description": "Simulates a forged request from another site: the browser sends the cookie automatically, but the attacker cannot read it to build the header."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 403', () => pm.response.to.have.status(403));",
                  "pm.test('Explains the CSRF problem', () => pm.expect(pm.response.json().detail).to.include('CSRF token'));"
                ]
              }
            }
          ]
        },
        {
          "name": "CSRF - header only, no cookie (403)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "{{apiAccept}}"
              },
              {
                "key": "Content-Type",
                "value": "{{apiAccept}}"
              },
              {
                "key": "X-Test-No-Csrf",
                "value": "true"
              },
              {
                "key": "X-XSRF-TOKEN",
                "value": "postman-header-only"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/contacts/public",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "contacts",
                "public"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Test\",\n  \"email\": \"postman@example.com\",\n  \"userType\": \"Employer\",\n  \"subject\": \"Testing\",\n  \"message\": \"Testing the CSRF cookie protection from Postman.\"\n}"
            },
            "description": "A header with a made-up value and no matching cookie is rejected: the value must equal the cookie."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 403', () => pm.response.to.have.status(403));",
                  "pm.test('Explains the CSRF problem', () => pm.expect(pm.response.json().detail).to.include('CSRF token'));"
                ]
              }
            }
          ]
        },
        {
          "name": "CSRF - header and cookie differ (403)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "{{apiAccept}}"
              },
              {
                "key": "Content-Type",
                "value": "{{apiAccept}}"
              },
              {
                "key": "X-Test-No-Csrf",
                "value": "true"
              },
              {
                "key": "Cookie",
