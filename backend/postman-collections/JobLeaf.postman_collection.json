            "description": "Uses the real token saved by the Login request. Run Login first."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Request passed security (not 401/403)', () => pm.expect(pm.response.code).to.not.be.oneOf([401, 403]));"
                ]
              }
            }
          ]
        }
      ]
