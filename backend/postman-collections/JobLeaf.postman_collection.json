            ],
            "url": {
              "raw": "{{baseUrl}}/companies",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "companies"
              ]
            },
            "description": "A valid token with an extra character, so the signature no longer matches."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('Content-Type is application/problem+json', () => {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "});",
                  "pm.test('Detail explains the problem', () => pm.expect(pm.response.json().detail).to.eql(\"The access token is invalid\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "{{apiAccept}}"
              },
              {
                "key": "Content-Type",
                "value": "{{apiAccept}}"
              }
            ],
            "url": {
