    {
      "name": "2. Authentication (JWT)",
      "description": "Secured paths (/jobleaf/** without /public). No secured endpoint exists yet, so a request that passes security answers 404: 401 -> 404 between 'no token' and 'valid token' proves the JWT is accepted.",
      "item": [
        {
          "name": "Secured path - no token (401)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "{{apiAccept}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/companies",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "companies"
              ]
            },
            "description": "Without a token the security filter chain rejects the request."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('Content-Type is application/problem+json', () => {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "});",
                  "pm.test('Detail explains the problem', () => pm.expect(pm.response.json().detail).to.eql(\"Authentication is required to access this resource\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Secured path - valid token (404 = passed security)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "{{apiAccept}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/companies",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "companies"
              ]
            },
            "description": "With a valid token the request gets past security; 404 only because no secured endpoint exists here yet."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Request passed security (not 401/403)', () => pm.expect(pm.response.code).to.not.be.oneOf([401, 403]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Secured path - expired token (401)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "{{apiAccept}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwtExpired}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/companies",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "companies"
              ]
            },
            "description": "A token whose exp is in the past."
