                  "});",
                  "pm.test('Detail explains the problem', () => pm.expect(pm.response.json().detail).to.eql(\"Invalid email or password\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Secured path - token from login (404 = passed security)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "{{apiAccept}}"
              },
