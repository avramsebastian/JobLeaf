{
  "info": {
    "_postman_id": "b5b74593-3422-53fc-8c32-fd9950e71ed5",
    "name": "JobLeaf API",
    "description": "Requests and automatic tests for the JobLeaf backend.\n\nSetup: import 'JobLeaf-Local.postman_environment.json', select it, set jwtSecret to the same value as the backend's JWT_SECRET_KEY. Start PostgreSQL and the backend first.\n\nRun everything at once with 'Run collection' (Collection Runner).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Creates test JWTs signed with the same secret as the backend (JWT_SECRET_KEY), until the login endpoint exists.",
          "// {{jwt}} = valid, {{jwtExpired}} = expired 1 minute ago, {{jwtTampered}} = valid token with a broken signature.",
          "const CryptoJS = require('crypto-js');",
          "",
          "const secret = pm.variables.get('jwtSecret');",
          "if (!secret) {",
          "    console.warn('jwtSecret is empty: select the \"JobLeaf Local\" environment and set jwtSecret to your JWT_SECRET_KEY');",
          "    return;",
          "}",
          "",
          "const base64Url = (words) => CryptoJS.enc.Base64.stringify(words)",
          "    .replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
          "const encode = (obj) => base64Url(CryptoJS.enc.Utf8.parse(JSON.stringify(obj)));",
          "",
          "const buildJwt = (expiresInSeconds) => {",
          "    const now = Math.floor(Date.now() / 1000);",
          "    const header = { alg: 'HS256', typ: 'JWT' };",
          "    const payload = {",
          "        iss: 'jobleaf',               // the backend only accepts tokens issued by JobLeaf",
          "        sub: pm.variables.get('tokenUserId'),  // user id: recorded in created_by/updated_by and the logs",
          "        email: pm.variables.get('tokenEmail'),",
          "        roles: pm.variables.get('tokenRoles'),",
          "        iat: now,",
          "        exp: now + expiresInSeconds",
          "    };",
          "    const unsigned = `${encode(header)}.${encode(payload)}`;",
          "    return `${unsigned}.${base64Url(CryptoJS.HmacSHA256(unsigned, secret))}`;",
          "};",
          "",
          "const jwt = buildJwt(3600);",
          "pm.variables.set('jwt', jwt);",
          "pm.variables.set('jwtExpired', buildJwt(-60));",
          "pm.variables.set('jwtTampered', `${jwt}x`);"
        ]
      }
    }
  ],
  "variable": [
