                  "const tokenCookie = pm.response.headers.all().filter(h => h.key.toLowerCase() === 'set-cookie').map(h => h.value)",
                  "    .find(v => v.startsWith('JOBLEAF_ACCESS_TOKEN='));",
                  "pm.test('Tells the browser to delete the token cookie (Max-Age=0, same path)', () => {",
                  "    pm.expect(tokenCookie, 'Set-Cookie for JOBLEAF_ACCESS_TOKEN').to.exist;",
                  "    pm.expect(tokenCookie).to.include('Max-Age=0');",
                  "    pm.expect(tokenCookie).to.include('Path=/jobleaf');",
                  "});"
                ]
